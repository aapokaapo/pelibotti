generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/postgresql-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id        String    @id @default(uuid())
  guildId   String
  name      String
  logoUrl   String?
  channels  Channel[]
  fixturesA Fixture[] @relation("FixtureTeamA")
  fixturesB Fixture[] @relation("FixtureTeamB")

  @@unique([guildId, name])
  @@index([guildId])
}

model Channel {
  id                            String           @id
  guildId                       String
  teamId                        String?
  team                          Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  defaultDates                  String[]         @default([])
  autoScheduleEnabled           Boolean          @default(false)
  scheduleDayOfWeek             Int              @default(0)
  scheduleHour                  Int              @default(12)
  scheduleMinute                Int              @default(0)
  lastScheduledWeekNumber       Int?
  lastManualScheduledWeekNumber Int?
  availabilities                Availability[]
  dateSuggestions               DateSuggestion[]

  @@index([guildId])
  @@index([teamId])
}

model Fixture {
  id              String           @id @default(uuid())
  guildId         String
  channelId       String?
  weekNumber      Int
  mapPool         String           @default("A") // Added map pool tracker
  teamAId         String
  teamBId         String
  teamA           Team             @relation("FixtureTeamA", fields: [teamAId], references: [id], onDelete: Restrict)
  teamB           Team             @relation("FixtureTeamB", fields: [teamBId], references: [id], onDelete: Restrict)
  availabilities  Availability[]
  dateSuggestions DateSuggestion[]

  @@index([guildId, channelId, weekNumber])
  @@unique([guildId, channelId, weekNumber, teamAId, teamBId])
}

model MapPool {
  id         String   @id @default(uuid())
  guildId    String
  channelId  String?
  weekNumber Int
  pool       String   @default("A") // Identify if this is pool A, B, or C
  maps       String[]

  // Updated to include 'pool' so multiple pools can exist for the same week
  @@unique([guildId, channelId, weekNumber, pool])
  @@index([guildId, channelId])
}

model Availability {
  id           String  @id @default(uuid())
  matchId      String
  messageId    String
  userId       String
  channelId    String
  selectedDate String
  fixture      Fixture @relation(fields: [matchId], references: [id], onDelete: Cascade)
  channel      Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId, messageId, selectedDate])
  @@index([channelId])
  @@index([messageId])
}

model DateSuggestion {
  id              String   @id @default(uuid())
  fixtureId       String
  messageId       String
  userId          String
  channelId       String
  suggestedDate   String
  suggestedHour   Int
  suggestedMinute Int
  createdAt       DateTime @default(now())
  fixture         Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, userId, messageId])
  @@index([channelId])
  @@index([messageId])
}
