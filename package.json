{
  "name": "pelibotti",
  "version": "1.0.0",
  "description": "Multi-server Discord league management bot scaffold.",
  "private": true,
  "main": "index.js",
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "start": "node index.js",
    "prisma:generate": "npm run prisma:generate:postgresql && npm run prisma:generate:sqlite",
    "prisma:generate:postgresql": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "prisma:push": "npm run prisma:push:postgresql",
    "prisma:push:postgresql": "prisma db push --schema=prisma/schema.prisma",
    "prisma:push:sqlite": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "prisma:migrate": "npm run prisma:migrate:postgresql",
    "prisma:migrate:postgresql": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:sqlite": "prisma migrate dev --schema=prisma/schema.sqlite.prisma"
  },
  "keywords": [
    "discord",
    "discord.js",
    "league",
    "prisma",
    "postgresql",
    "sqlite"
  ],
  "author": "",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "csv-parse": "^7.0.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "multer": "^2.4.0",
    "node-cron": "4.2.1"
  },
  "devDependencies": {
    "prisma": "^6.12.0"
  }
}
